# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 采集缓存与数据库（由 Actions 每次重建，不入库）
spider/data/cache/
spider/data/*.db
spider/data/*.db-wal
spider/data/*.db-shm

# cqshushu 采集中间态（断点续抓进度，每次运行重建）
spider/data/shushu_list.json
spider/data/shushu_detail.json
spider/data/shushu_relays.json
# 探测缓存（3 小时内复用，不入库）
spider/data/hosts_probe.json

# API 采集的原始产物（几 MB，只在当轮合并里用，不入库）
# 池子的持久状态是 data/proxy.json，它会被 udpxy.py 当作延续源
spider/data/api_hosts.json
spider/data/api_cache.json
spider/data/proxy_api.m3u
spider/data/foodie_hosts.json
spider/data/foodie_cache.json
spider/data/proxy_foodie.m3u

# 系统
.DS_Store
Thumbs.db

# 中转地址池与地区表：含全量播放地址/主机信息，只存 state 分支，
# 不进 main（GitHub Pages 会公开 main 的全部内容）
data/proxy.json
data/regions.json
# 酒店源地址池（同样含全量播放地址，只存 state 分支）
data/proxy_hotel.json
data/proxy_gangaotai.json
data/proxy_intl.json

# 酒店源采集中间态（每轮重建，不入库；成品是 data/proxy_hotel.json）
spider/data/hotel_ok.json
spider/data/hotel_hosts.json
spider/data/proxy_hotel.m3u
data/_deep_*.log
data/_deep_*.json
